{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "/usam-communities/app",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "units": ["usam-communities.service", "usam-health.service", "usam-backup.service"]
          }
        ]
      },
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/usam.error.log",
            "log_group_name": "/usam-communities/nginx-error",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/nginx/usam.access.log",
            "log_group_name": "/usam-communities/nginx-access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "UsamCommunities",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "swap": { "measurement": ["swap_used_percent"] }
    }
  }
}
