# =============================================================================
# USAM Communities - environment reference
#
#   Local development : copy to .env (NOT committed) - most values can be omitted.
#   Production (EC2)  : the same variables go in /etc/usam-communities/env
#                       (root:usam, mode 640). NEVER commit real values.
#
# Anything marked REQUIRED(prod) makes `NODE_ENV=production` refuse to start
# when missing/unsafe (see assertProductionConfig in server/config.js).
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # production on the server
PORT=3001
LOG_LEVEL=info                       # debug | info | warn | error

# ---- Public URLs (REQUIRED(prod): must be https://) -------------------------
# Used for CSRF/origin checks and for the links inside verification / reset /
# billing emails. No trailing slash.
APP_ORIGIN=http://127.0.0.1:3001
FRONTEND_URL=http://127.0.0.1:3001

# ---- Database ---------------------------------------------------------------
# dev/test: sqlite (default). production: postgres on AWS RDS.
DB_DIALECT=sqlite                    # REQUIRED(prod): postgres
SQLITE_PATH=./data/usam.sqlite       # sqlite only
# Preferred for RDS - one URL (URL-encode special characters in the password):
# DATABASE_URL=postgres://usam_app:PASSWORD@your-db.xxxx.eu-central-1.rds.amazonaws.com:5432/usam
# Or discrete variables instead of DATABASE_URL:
# DB_HOST= / DB_PORT=5432 / DB_NAME= / DB_USER= / DB_PASSWORD=
DB_SSL=false                         # true for RDS (TLS)
# DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem   # recommended: full verification
DB_POOL_MAX=10
DB_POOL_MIN=0

# ---- Sessions & security ----------------------------------------------------
COOKIE_SECURE=false                  # REQUIRED(prod): true
SESSION_DAYS=30
REGISTRATION_ENABLED=true            # false = close public signup
REQUIRE_EMAIL_VERIFICATION=true      # unverified members cannot post/join/pay
# Two-factor (TOTP). Generate the key with: openssl rand -hex 32
# Needed before anyone can enrol; the per-user secret is AES-256-GCM encrypted with it.
# Keep it stable: changing it makes existing enrolments unusable.
MFA_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=false              # true = moderators/admins must enrol before using admin tools
MFA_ISSUER=USAM Communities
# Rate limits (defaults shown). RATE_LIMIT_DISABLED is refused in production.
# RATE_LIMIT_API_PER_MIN=600
# RATE_LIMIT_AUTH_PER_15MIN=30
# RATE_LIMIT_WRITE_PER_MIN=120
# RATE_LIMIT_EMAIL_PER_HOUR=6
# RATE_LIMIT_FORGOT_PER_HOUR=3
# RATE_LIMIT_PAYMENT_PER_10MIN=20

# ---- Email ------------------------------------------------------------------
# console = log only (dev). ses = Amazon SES. smtp = any SMTP relay.
EMAIL_PROVIDER=console               # REQUIRED(prod): ses (or smtp)
EMAIL_FROM="USAM Communities <no-reply@usam.example>"   # must be a VERIFIED SES identity
EMAIL_REPLY_TO=
AWS_SES_REGION=eu-central-1
# SES credentials come from the AWS SDK default chain. On EC2 attach an IAM
# role with ses:SendEmail / ses:SendRawEmail - do NOT put access keys in this file.
# SMTP (only if EMAIL_PROVIDER=smtp):
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS= / SMTP_SECURE=false

# ---- Payments: Paymob (Egypt) ----------------------------------------------
# Leave disabled until you have merchant credentials AND have configured the
# Paymob dashboard (see PRODUCTION_DEPLOYMENT_GUIDE.md section "Paymob").
PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=                  # REQUIRED when PAYMOB_ENABLED=true (webhook signatures)
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_CURRENCY=EGP

# ---- File storage -----------------------------------------------------------
STORAGE_DRIVER=local                 # production: s3
MAX_UPLOAD_BYTES=10485760            # 10 MB image policy (avatars)
# local driver:
MEDIA_ROOT=./media
MEDIA_PUBLIC_PATH=/media
# s3 driver (IAM role needs s3:PutObject / s3:DeleteObject on the bucket):
# S3_BUCKET=usam-communities-media
# S3_REGION=eu-central-1
# S3_PUBLIC_BASE_URL=https://media.usam.example   # CloudFront / bucket URL

# ---- Migrations -------------------------------------------------------------
# Production runs pending migrations at boot (safety net; deploy.sh migrates
# first). Set false when running more than one instance.
# MIGRATE_ON_BOOT=true

# ---- Background worker ------------------------------------------------------
# Runs the email outbox + scheduled jobs inside the web process (single
# instance). On >1 instance enable on exactly ONE node.
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10

# ---- Observability (optional) ----------------------------------------------
SENTRY_DSN=

# ---- First admin (used only by `npm run create:admin`) ----------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=                    # 16+ characters, unique
# ADMIN_NAME=

# Google sign-in (optional). OAuth client type 'Web application' in Google Cloud Console.
# Authorised redirect URI: {APP_ORIGIN}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
